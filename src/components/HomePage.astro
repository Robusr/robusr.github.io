---
import type { Locale, Messages } from '../i18n/types';
import Header from './Header.astro';
import Hero from './Hero.astro';
import ProjectList from './ProjectList.astro';
import Journey from './Journey.astro';
import Awards from './Awards.astro';
import MoreWork from './MoreWork.astro';
import About from './About.astro';
import MiniLab from './MiniLab.astro';
import PrintCover from './PrintCover.astro';
import Footer from './Footer.astro';

const { locale, t } = Astro.props as { locale: Locale; t: Messages };
---
{locale === 'en' && (
  <div class="lang-hint" data-lang-hint hidden>
    <div class="wrap lang-hint-inner">
      <span>{t.langHint}</span>
      <a href="/zh/" data-anchor-link data-base="/zh/">中文</a>
      <span aria-hidden="true">/</span>
      <a href="/fr/" data-anchor-link data-base="/fr/">Français</a>
      <button type="button" data-lang-hint-close>{t.dismiss}</button>
    </div>
  </div>
  <script is:inline>
    (function () {
      try {
        var lang = (navigator.language || '').toLowerCase();
        var dismissed = sessionStorage.getItem('lang-hint-dismissed') === '1';
        if (!dismissed && (lang.indexOf('zh') === 0 || lang.indexOf('fr') === 0)) {
          var hint = document.querySelector('[data-lang-hint]');
          if (hint) hint.hidden = false;
        }
      } catch (e) {}
    })();
  </script>
)}
<PrintCover locale={locale} t={t} />
<Header locale={locale} t={t} />
<main id="main">
  <Hero locale={locale} t={t} />
  <MiniLab locale={locale} />
  <ProjectList locale={locale} t={t} />
  <Journey locale={locale} t={t} />
  <Awards locale={locale} t={t} />
  <MoreWork locale={locale} t={t} />
  <About locale={locale} t={t} />
</main>
<Footer locale={locale} t={t} />
<dialog class="plate-dialog" data-plate-dialog aria-labelledby="plate-dialog-title">
  <div class="plate-dialog-head">
    <p class="plate-dialog-title" id="plate-dialog-title" data-dialog-title></p>
    <button class="plate-dialog-close" type="button" data-dialog-close>{t.plate.close}</button>
  </div>
  <div class="plate-dialog-media" data-dialog-media></div>
  <p class="plate-dialog-caption" data-dialog-caption></p>
</dialog>
