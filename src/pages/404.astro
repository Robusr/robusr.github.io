---
import Base from '../layouts/Base.astro';
import t from '../i18n/en.json';
---
<Base locale="en" t={t} noindex path="/404.html" title="Sheet missing — Robusr Guo">
  <main id="main" class="wrap notfound">
    <div class="notfound-sheet">
      <p class="notfound-figure" aria-hidden="true">404</p>
      <div class="notfound-copy">
        <p class="eyebrow">SHEET 404 · MISSING</p>
        <h1>This sheet is missing.</h1>
        <p class="notfound-body">
          The page you are looking for is not in this set. Return to <a href="/">the homepage</a>,
          or read it in <a href="/zh/">中文</a> or <a href="/fr/">Français</a>.
        </p>
        <p class="notfound-meta">ROBUSR.CN · 2026</p>
      </div>
    </div>
  </main>
</Base>
